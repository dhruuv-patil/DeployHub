# DeployHub Environment Configuration
# Copy this file to .env and adjust variables as needed

# Flask Application Settings
PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# MySQL Database Settings
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=devops

# Optional: Fallback to SQLite (set to true for local testing without MySQL)
USE_SQLITE=false
